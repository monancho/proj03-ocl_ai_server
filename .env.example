# Copy this file to .env and replace placeholders with real values.
# Do not commit .env or real secret values.

OPENAI_API_KEY=your-openai-api-key
AI_SERVER_API_KEY=your-internal-api-key

AI_TEXT_MODEL=gpt-5.4-mini
IMAGE_MODERATION_MODEL=omni-moderation-latest

MAX_SOURCE_CHARS=12000
MAX_IMAGE_SIZE_MB=5
REQUEST_TIMEOUT_SECONDS=15
AI_DAILY_REQUEST_LIMIT=100
AI_RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info
